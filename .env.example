# =============================================================================
# .env.example — copy to .env.local for local development.
# Never commit .env.local — it is git-ignored by .gitignore.
# =============================================================================

# Local Docker PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://gymuser:gympassword@localhost:5432/gymdb

# Supabase project credentials (fill in from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Angular — must be prefixed with NG_APP_ to be exposed to the browser bundle
NG_APP_SUPABASE_URL=${SUPABASE_URL}
NG_APP_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
